<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>DuelHostProgram</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="WindBotAi.cs" />
    <Compile Include="ClassicMessageSplitter.cs" />
    <Compile Include="..\windbot_standalone\src\Windbot\**\*.cs" />
    <Compile Include="..\windbot_standalone\src\YGOSharp\YGOSharp.Network\**\*.cs" />
    <Compile Include="..\windbot_standalone\src\YGOSharp\YGOSharp.OCGWrapper\**\*.cs" />
    <Compile Include="..\windbot_standalone\src\YGOSharp\YGOSharp.OCGWrapper.Enums\**\*.cs" />
    <Compile Remove="..\windbot_standalone\src\Windbot\BotWrapper.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- 只为了让 YGOSharp 的 sqlite 代码通过编译；运行时走 cards.json 加载，不会碰它 -->
    <Reference Include="Mono.Data.Sqlite">
      <HintPath>$(MSBuildThisFileDirectory)..\..\refs\Mono.Data.Sqlite.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
